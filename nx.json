{
	"tasksRunnerOptions": {
		"default": {
			"runner": "nx/tasks-runners/default",
			"options": {
				"cacheableOperations": [
					"build",
					"generate",
					"lint",
					"test"
				]
			}
		}
	},
	"targetDependencies": {
		"build": [
			{
				"target": "build",
				"projects": "dependencies"
			}
		]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": [
				"^build"
			]
		},
		"dev": {
			"dependsOn": [
				"^build"
			]
		},
		"publish": {
			"dependsOn": [
				"^build"
			]
		},
		"test": {
			"dependsOn": [
				"^build"
			]
		}
	}
}
